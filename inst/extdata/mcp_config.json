{
  "mcpServers": {
    "alphavantage": {
      "url": "https://mcp.alphavantage.co/mcp?apikey=MY_API_KEY"
    },
    "openecon": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://data.openecon.ai/mcp",
        "--header",
        "Authorization: Bearer ${OPENECON_TOKEN}"
      ],
      "env": {
        "OPENECON_TOKEN": "paste-your-jwt-here"
      }
    }
  }
}
